# Server-side SMTP settings for the profile feedback form.
# For Gmail, use an App Password (not your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password

# Optional sender override; defaults to SMTP_USER.
# SMTP_FROM=Bibble <your-address@gmail.com>

# Feedback recipient. Keep this configured server-side.
FEEDBACK_EMAIL=your-inbox@example.com
